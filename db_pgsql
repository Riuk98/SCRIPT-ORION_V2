--===================================================================================================
--                                Tabla de parámetros generales de la empresa
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_parametros 
(
    id_empresa                    DECIMAL(10,0)             NOT NULL        CHECK(id_empresa != 0),                                               --NIT de la empresa
    nom_empresa                   VARCHAR                   NOT NULL        CHECK(LENGTH(nom_empresa) > 2),         --Nombre de la empresa
    dir_empresa                   VARCHAR                   NOT NULL        CHECK(LENGTH(dir_empresa) > 10),        --Dirección de la empresa
    tel_empresa                   DECIMAL(10,0)             NOT NULL        CHECK(tel_empresa > 6000000000),        --Teléfono de la empresa
    cel_empresa                   DECIMAL(10,0)             NOT NULL        CHECK(cel_empresa > 3000000000),        --Celular de la empresa
    correo_empresa                VARCHAR                   NOT NULL        CHECK(correo_empresa ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'),  -- correo de la empresa 
    logo_empresa                  VARCHAR                   NOT NULL                                               --URL o ruta del logo de la empresa
    --val_pordesc                   DECIMAL(3,0)              NOT NULL        CHECK(val_pordesc >= 0 AND val_pordesc <= 100) -- valor porcentaje para descuentos
);

--===================================================================================================
--                                Tabla de departamentos
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_dptos
(
    id_dpto                     VARCHAR                     NOT NULL        CHECK(id_dpto ~ '^[0-99]+$'),                                        --Código del departamento 
    nom_dpto                    VARCHAR                     NOT NULL        CHECK(LENGTH(nom_dpto) > 2),    --Nombre del departamento
    PRIMARY KEY(id_dpto)
);

--===================================================================================================
--                                Tabla de ciudades con relación a departamentos
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_ciudades
(
    id_ciudad                   VARCHAR                     NOT NULL        CHECK(id_ciudad ~ '^[0-99999]+$'),		--Código de la ciudad
    id_dpto                     VARCHAR                     NOT NULL        CHECK(id_dpto ~ '^[0-99]+$'), 			--FK a tabla de departamentos
    nom_ciudad                  VARCHAR                     NOT NULL        CHECK(LENGTH(nom_ciudad) > 2),   		--Nombre de la ciudad
    val_zip                     DECIMAL(6,0)                NOT NULL        CHECK(id_ciudad ~ '^[0-99999]+$'),		--Código postal de la ciudad
    PRIMARY KEY(id_ciudad),
    FOREIGN KEY(id_dpto)                                    REFERENCES tab_dptos(id_dpto)
);

--===================================================================================================
--                                Tabla de terceros almacenados
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_terceros
(
    id_tercero                  DECIMAL(10,0)               NOT NULL        CHECK(id_tercero != 0 AND id_tercero > 20000000),		--Documento de cliente, proveedor, empleado, empresa, etc.
    tipo_documento              DECIMAL(1,0)                NOT NULL        CHECK(tipo_documento >= 0 AND tipo_documento <= 6), 	--0 CC, 1 NIT
    nom_tercero                 VARCHAR                     NOT NULL        CHECK(LENGTH(nom_tercero) >= 1),						--Nombre del tercero
    ape1_tercero                VARCHAR                     NOT NULL        CHECK(LENGTH(ape1_tercero) >= 2),						--Apellido 1 del tercero
    ape2_tercero                VARCHAR                     NOT NULL        CHECK(LENGTH(ape2_tercero) >= 2),						--Apellido 2 del tercero
    estado                      BOOLEAN                     NOT NULL,        														--TRUE: Activo, FALSE: Inactivo
    cel_tercero                 DECIMAL(10,0)               NOT NULL        CHECK(cel_tercero > 3000000000),						--Celular del tercero
    tel_tercero                 DECIMAL(10,0)               NOT NULL        CHECK(tel_tercero > 6000000000),						--Teléfono del tercero
    correo_tercero              VARCHAR                     NOT NULL        CHECK(correo_tercero ~* '^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\.[A-Za-z]{2,}$'), --Correo electrónico del tercero
    fecha_creacion              TIMESTAMP                   NOT NULL,       														--Fecha de creación del registro
    PRIMARY KEY(id_tercero)
);

CREATE INDEX IF NOT EXISTS idx_tercero_nombre ON tab_terceros(nom_tercero);
CREATE INDEX IF NOT EXISTS cel_tercero_idx ON tab_terceros(cel_tercero);
CREATE INDEX IF NOT EXISTS correo_tercero_idx ON tab_terceros(correo_tercero);

--===================================================================================================
--                                Tabla de direcciones de terceros
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_tercero_direcciones
(
    id_direccion                DECIMAL(1,0)                NOT NULL        CHECK(id_direccion >= 0 AND id_direccion <= 9),    		--cantidad de direcciones almacenadas por cada tercero teniedno como 10 numero maximo
    id_tercero                  DECIMAL(10,0)               NOT NULL        CHECK(id_tercero != 0 AND id_tercero > 20000000),       	--FK a tabla de terceros
    dir_principal               BOOLEAN                     NOT NULL,       														--TRUE: Dirección principal, FALSE: Dirección secundaria
    alias_dir                   DECIMAL(1,0)                NOT NULl        CHECK(alias_dir >= 0 AND alias_dir <= 5),						--Casa apto oficina
    dir_tercero                 VARCHAR                     NOT NULL        CHECK(LENGTH(dir_tercero) > 10),   
    id_ciudad                   VARCHAR                     NOT NULL        CHECK(id_ciudad ~ '^[0-99999]+$'),       				--FK a tabla de ciudades
    estado                      BOOLEAN                     NOT NULL,       														--TRUE: Activo, FALSE: Inactivo
    fecha_creacion              TIMESTAMP                   NOT NULL,       														--Fecha de creación del registro
    PRIMARY KEY (id_direccion, id_tercero),
    FOREIGN KEY (id_tercero)                                REFERENCES tab_terceros(id_tercero),
    FOREIGN KEY (id_ciudad)                                 REFERENCES tab_ciudades(id_ciudad)
);

--===================================================================================================
--                                Tabla de bancos almacenados en el sistema
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_bancos
(
    id_banco                    DECIMAL(4,0)                NOT NULL        CHECK(id_banco > 1000 and id_banco < 2000),				--Código del banco 
    nom_banco                   VARCHAR                     NOT NULL        CHECK(LENGTH(nom_banco) > 2),							--Nombre del banco
    dir_banco                   VARCHAR                     NOT NULL        CHECK(LENGTH(dir_banco) > 10), 							--Dirección del banco
    tel_ban                     VARCHAR                     NOT NULL        CHECK(tel_ban::BIGINT > 6000000000),       						--Teléfono del banco
    id_encargado                DECIMAL(10,0)               NOT NULL        CHECK(id_encargado != 0 AND id_encargado > 20000000),	--FK a tabla de terceros
    estado                      BOOLEAN                     NOT NULL,       														--TRUE: Activo, FALSE: Inactivo
    PRIMARY KEY(id_banco),
    FOREIGN KEY(id_encargado)                               REFERENCES tab_terceros(id_tercero)
);
CREATE INDEX IF NOT EXISTS idx_banco_nombre ON tab_bancos(nom_banco);

--===================================================================================================
--                                Tabla de relación terceros/bancos
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_terceros_banco
(
    id_tercero                  DECIMAL(10,0)               NOT NULL        CHECK(id_tercero != 0 AND id_tercero > 20000000),       			--FK a tabla de terceros
    id_banco                    DECIMAL(4,0)                NOT NULL        CHECK(id_banco > 1000 and id_banco < 2000),       					--FK a tabla de bancos
    num_cuenta                  DECIMAL(12,0)               NOT NULL        CHECK(num_cuenta >= 1000000000 AND num_cuenta <= 999999999999),		--Número de cuenta del tercero en el banco
    tipo_cuenta                 DECIMAL(1,0)                NOT NULL        CHECK(tipo_cuenta >= 0 AND tipo_cuenta <= 2),						--0 AHORROS, 1 CORRIENTE
    PRIMARY KEY(id_tercero,id_banco),
    FOREIGN KEY(id_tercero)                                 REFERENCES tab_terceros(id_tercero),
    FOREIGN KEY(id_banco)                                   REFERENCES tab_bancos(id_banco)
);

