--===================================================================================================
--                                Tabla de documentos contables
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_doc_contable
(
    id_documento                VARCHAR                     NOT NULL, --ID unico del documento contable
    id_tipo_doc_orig            DECIMAL(2,0)                NOT NULL, --FK a tabla de tipos de documento (tipo de documento que origina el documento contable)
    consecutivo_doc             DECIMAL(4,0)                NOT NULL, --Consecutivo del documento contable
    fecha_doc                   TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Fecha del documento contable
    id_tercero                  DECIMAL(10,0)               NOT NULL, --FK a tabla de terceros (cliente, proveedor, empleado, etc)
    concepto_doc                VARCHAR                     NOT NULL, --Concepto o descripción del documento contable
    estado                      BOOLEAN                     NOT NULL, --TRUE: Activo, FALSE: Anulado
    id_usuario_creacion         VARCHAR                     NOT NULL, --FK a tabla de usuarios (usuario que creó el documento)
    fecha_creacion              TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Fecha de creación del documento
    fecha_modifica              TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Fecha de última modificación del documento
    id_usuario_modifica         VARCHAR                     NOT NULL, --FK a tabla de usuarios (usuario que modificó el documento por última vez)
    PRIMARY KEY(id_documento),
    FOREIGN KEY(id_tercero)                                 REFERENCES tab_terceros(id_tercero), 
    FOREIGN KEY(id_usuario_creacion)                        REFERENCES tab_usuarios(id_usuario),
    FOREIGN KEY(id_usuario_modifica)                        REFERENCES tab_usuarios(id_usuario),
    FOREIGN KEY(id_tipo_doc_orig)                           REFERENCES tab_tipos_documento(id_tipo_doc)
);

--===================================================================================================
--                                Tabla de detalle de documentos contables
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_detalle_doc_contable
(
    id_detalle                  DECIMAL(4,0)                NOT NULL, --ID unico del detalle del documento contable
    id_documento                VARCHAR                     NOT NULL, --FK a tabla de documentos contables
    id_cuenta                   VARCHAR                     NOT NULL, --FK a tabla de PUC
    descripcion_mov             VARCHAR                     NOT NULL, --Descripción del movimiento contable
    naturaleza                  DECIMAL(1,0)                NOT NULL, --Naturaleza del movimiento (0 Débito, 1 Crédito)
    valor_movimiento            DECIMAL(9,2)                NOT NULL, --Valor del movimiento contable
    PRIMARY KEY(id_detalle),
    FOREIGN KEY(id_documento)                               REFERENCES tab_doc_contable(id_documento),
    FOREIGN KEY(id_cuenta)                                  REFERENCES tab_puc(id_cuenta)
);

