CREATE TABLE IF NOT EXISTS tab_clientes
(
    id_cliente                  DECIMAL(10,0)               NOT NULL        CHECK(id_cliente != 0 AND id_cliente > 20000000),       			--FK a tabla de terceros
    tipo_cliente                DECIMAL(1,0)                NOT NULL        CHECK(tipo_cliente >= 0 AND tipo_cliente <= 2), 					--TRUE: Persona Natural, FALSE: Persona Jurídica -- MAYORISTA O MINORISTA?
    estado_cliente              BOOLEAN                     NOT NULL,       																	--TRUE: Activo, FALSE: Inactivo
