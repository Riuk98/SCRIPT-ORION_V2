    limit_cred                  DECIMAL(6,0)                NOT NULL        CHECK(limit_cred >= 0 AND limit_cred <= 999999)        DEFAULT 0, 	--Límite de crédito del cliente
    observaciones               VARCHAR                     NOT NULL        DEFAULT 'Sin observaciones',  										--Observaciones sobre el cliente
    PRIMARY KEY(id_cliente),
    FOREIGN KEY(id_cliente)                                 REFERENCES tab_terceros(id_tercero) 
);

