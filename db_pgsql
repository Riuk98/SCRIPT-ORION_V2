--===================================================================================================
--                        Tabla de PQRS (Peticiones, Quejas, Reclamos, Sugerencias)
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_pqrs
(
    id_ticket                   VARCHAR                     NOT NULL           CHECK(id_ticket != ' '), --ID unico del ticket PQR - P000001 - Q000001 etc
    id_tercero                  DECIMAL(10,0)               NOT NULL,       --FK a tabla de terceros (quien realiza la PQR)
    id_usuario                  VARCHAR                     NOT NULL,       --FK a tabla de usuarios (quien atiende la PQR)
    id_estado                   DECIMAL(2,0)                NOT NULL,       --FK a tabla de estados (estado actual de la PQR)
    tipo_pqr                    DECIMAL(1,0)                NOT NULL           CHECK(tipo_pqr >= 1 AND tipo_pqr <= 4), --1 peticion, 2 queja, 3 reclamo, 4 sugerencia
    prior_pqr                   DECIMAL(1,0)                NOT NULL           CHECK(prior_pqr >= 1 AND prior_pqr <= 3), --1 alta, 2 media, 3 baja
    canal_pqr                   DECIMAL(1,0)                NOT NULL           CHECK(canal_pqr >= 1 AND canal_pqr <= 4), --1 telefono, 2 email, 3 presencial, 4 web etc
    fecha_creacion              TIMESTAMP                   NOT NULL           CHECK(fecha_creacion <= now()),--Fecha de creación del ticket PQR
    area_pqr                    DECIMAL(2,0)                NOT NULL           CHECK(area_pqr >= 1 AND area_pqr <= 6), --área responsable de atender la PQR 1 SAC, 2 COMERCIAL, 3 LOGISTICA(DESPACHOS), 4 TESORERIA, 5 CONTABILIDAD, 6 ADMINISTRATIVOS 
    descrip_prq                 VARCHAR                     NOT NULL           CHECK(descrip_prq != ' '), --Descripción detallada de la PQR
    PRIMARY KEY(id_ticket),
    FOREIGN KEY(id_tercero)                                 REFERENCES tab_terceros(id_tercero),
    FOREIGN KEY(id_usuario)                                 REFERENCES tab_usuarios(id_usuario),
    FOREIGN KEY(id_estado)                                  REFERENCES tab_estados(id_estado)
);
