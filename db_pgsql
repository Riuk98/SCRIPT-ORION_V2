CREATE TABLE IF NOT EXISTS tab_conceptos_nomina
(
    id_concepto                 DECIMAL(3,0)                NOT NULL    CHECK(id_concepto > 0), --ID unico del concepto de nómina: Salario, Auxilio de transporte, Salud, Pensión, etc
    nombre_concepto             VARCHAR                     NOT NULL    CHECK(nombre_concepto != ' '), --Nombre del concepto de nómina
    descripcion_concepto        VARCHAR                     NOT NULL    CHECK(descripcion_concepto != ' '), --Descripción del concepto de nómina
    tipo_concepto               BOOLEAN                     NOT NULL,    -- CHECK(tipo_concepto > 0 AND tipo_concepto < 2), --0 Devengos, 1 Deducciones
    porcentaje                  DECIMAL(4,2)                NOT NULL    CHECK(porcentaje >= 0), --Porcentaje aplicado al concepto (si aplica)
    id_cuenta                   VARCHAR                     NOT NULL    CHECK(id_cuenta != ' '), --Cuenta contable asociada al concepto
    estado                      BOOLEAN                     NOT NULL    DEFAULT TRUE, --TRUE: Activo, FALSE: Inactivo
    PRIMARY KEY(id_concepto),
    FOREIGN KEY(id_cuenta)                                  REFERENCES tab_puc(id_cuenta)
);

--===================================================================================================
--                                Tabla de nómina
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_nomina
(
    id_nomina                   DECIMAL(3,0)                NOT NULL    CHECK(id_nomina > 0), --ID unico de la nómina
    id_empleado                 DECIMAL(10,0)               NOT NULL, --FK a tabla de empleados
    id_tipo_doc                 DECIMAL(2,0)                NOT NULL, --FK a tabla de tipos de documento   
    fecha_inicio                TIMESTAMP WITHOUT TIME ZONE NOT NULL    CHECK(fecha_inicio < now()), --Inicio del periodo liquidado
    fecha_fin                   TIMESTAMP WITHOUT TIME ZONE NOT NULL    CHECK(fecha_fin > fecha_inicio), --Fin del periodo liquidado
    fecha_pago                  TIMESTAMP WITHOUT TIME ZONE NOT NULL    CHECK(fecha_pago >= fecha_fin), --Fecha de pago de la nómina // esto debe ser actualizable UPDATE
    salario_base                DECIMAL(9,2)                NOT NULL    CHECK(salario_base >= 0), --Salario base del empleado
    estado                      BOOLEAN                     NOT NULL    DEFAULT FALSE, --TRUE: Pagada, FALSE: Pendiente
    observaciones               VARCHAR                     NOT NULL    CHECK(observaciones != ' '), --Observaciones sobre la nómina
    PRIMARY KEY(id_nomina),
    FOREIGN KEY(id_empleado)                                REFERENCES tab_empleados(id_empleado),
    FOREIGN KEY(id_tipo_doc)                                REFERENCES tab_tipos_documento(id_tipo_doc)
);

--===================================================================================================
--                                Tabla de detalle de nómina
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_detalle_nomina
(
    id_nomina                   DECIMAL(3,0)                NOT NULL, --FK a tabla de nómina
    id_concepto                 DECIMAL(3,0)                NOT NULL, --FK a tabla de conceptos de nómina
