--===================================================================================================
--                                Tabla de conceptos de nómina
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_conceptos_nomina
(
    id_concepto                 DECIMAL(3,0)                NOT NULL, --ID unico del concepto de nómina: Salario, Auxilio de transporte, Salud, Pensión, etc
    nombre_concepto             VARCHAR                     NOT NULL, --Nombre del concepto de nómina
    descripcion_concepto        VARCHAR                     NOT NULL, --Descripción del concepto de nómina
    tipo_concepto               DECIMAL(1,0)                NOT NULL, --0 Devengos, 1 Deducciones
    porcentaje                  DECIMAL(4,2)                NOT NULL, --Porcentaje aplicado al concepto (si aplica)
    id_cuenta                   VARCHAR                     NOT NULL, --Cuenta contable asociada al concepto
    estado                      BOOLEAN                     NOT NULL, --TRUE: Activo, FALSE: Inactivo
    PRIMARY KEY(id_concepto),
    FOREIGN KEY(id_cuenta)                                  REFERENCES tab_puc(id_cuenta)
);

--===================================================================================================
--                                Tabla de nómina
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_nomina
(
    id_nomina                   DECIMAL(3,0)                NOT NULL, --ID unico de la nómina
    id_empleado                 DECIMAL(10,0)               NOT NULL, --FK a tabla de empleados
    id_tipo_doc                 DECIMAL(2,0)                NOT NULL, --FK a tabla de tipos de documento   
    fecha_inicio                TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Inicio del periodo liquidado
    fecha_fin                   TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Fin del periodo liquidado
    fecha_pago                  TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Fecha de pago de la nómina // esto debe ser actualizable UPDATE
    salario_base                DECIMAL(9,2)                NOT NULL, --Salario base del empleado
    estado                      BOOLEAN                     NOT NULL, --TRUE: Pagada, FALSE: Pendiente
    observaciones               VARCHAR                     NOT NULL, --Observaciones sobre la nómina
    PRIMARY KEY(id_nomina),
    FOREIGN KEY(id_empleado)                                REFERENCES tab_empleados(id_empleado),
    FOREIGN KEY(id_tipo_doc)                                REFERENCES tab_tipos_documento(id_tipo_doc)
);

--===================================================================================================
--                                Tabla de detalle de nómina
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_detalle_nomina
(
    id_nomina                   DECIMAL(3,0)                NOT NULL, --FK a tabla de nómina
    id_concepto                 DECIMAL(3,0)                NOT NULL, --FK a tabla de conceptos de nómina
    cantidad                    DECIMAL(4,2)                NOT NULL, --Cantidad del concepto aplicado en la nómina // Decimales por dos cosas medir en cantidad de días laborados el concepto (14.0 dias) y medir tambien en horas los conceptos correspondientes (3.5 horas)
    valor_unitario              DECIMAL(8,2)                NOT NULL, --Valor unitario del concepto en la nómina
    valor_total                 DECIMAL(8,2)                NOT NULL, --Valor total del concepto en la nómina
    observaciones               VARCHAR                     NOT NULL, --Observaciones sobre el detalle de la nómina
    PRIMARY KEY(id_nomina,id_concepto),
    FOREIGN KEY(id_nomina)                                  REFERENCES tab_nomina(id_nomina),
    FOREIGN KEY(id_concepto)                                REFERENCES tab_conceptos_nomina(id_concepto)
);

--===================================================================================================
--                                Tabla de cuentas por cobrar (CXC)
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_cxc
(
    id_cxc                      VARCHAR                     NOT NULL, --ID unico de la cuenta por cobrar
    id_factura                  VARCHAR                     NOT NULL, --FK a tabla de encabezado de facturas de venta
    id_cliente                  DECIMAL(10,0)               NOT NULL, --FK a tabla de clientes
    fecha_emision               TIMESTAMP                   NOT NULL, --SE GENERA FECHA DE CUENTA POR COBRAR
    fecha_vencimiento           TIMESTAMP WITHOUT TIME ZONE NOT NULL, --SE ESTABLECE FECHA DE CUENTA POR COBRAR
    valor_factura               DECIMAL(8,2)                NOT NULL, --Valor total de la factura
    saldo_factura               DECIMAL(8,2)                NOT NULL, --Saldo pendiente de la factura
    id_estado                   DECIMAL(2,0)                NOT NULL, --FK a tabla de estados (1 Pendiente, 2 Parcialmente pagada, 3 Pagada, 4 Vencida, 5 En mora, 6 Refinanciada, 7 Cuenta castigada, 8 Anulada.)
    PRIMARY KEY(id_cxc),
    FOREIGN KEY(id_factura)                                 REFERENCES tab_encabezado_factura_venta(id_factura),
    FOREIGN KEY(id_cliente)                                 REFERENCES tab_clientes(id_cliente),
    FOREIGN KEY(id_estado)                                  REFERENCES tab_estados(id_estado)
);

--===================================================================================================
--                                Tabla de cuentas por pagar (CXP)
--===================================================================================================

CREATE TABLE IF NOT EXISTS tab_cxp
(
    id_cxp                      VARCHAR                     NOT NULL, --ID unico de la cuenta por pagar
    id_factura_compra           VARCHAR                     NOT NULL, --FK a tabla de encabezado de facturas de compra
    id_proveedor                DECIMAL(10,0)               NOT NULL, --FK a tabla de proveedores
    fecha_registro              TIMESTAMP WITHOUT TIME ZONE NOT NULL, --SE GENERA FECHA DE CUENTA POR PAGAR
    fecha_vencimiento           TIMESTAMP WITHOUT TIME ZONE NOT NULL, --SE ESTABLECE FECHA DE CUENTA POR PAGAR 
    valor_factura               DECIMAL(8,2)                NOT NULL, --Valor total de la factura
    saldo_factura               DECIMAL(8,2)                NOT NULL, --Saldo pendiente de la factura
    id_estado                   DECIMAL(2,0)                NOT NULL, --FK a tabla de estados (1 Pendiente, 2 Parcialmente pagada, 3 Pagada, 4 Vencida, 5 En mora, 6 Refinanciada, 7 Cuenta castigada, 8 Anulada.)
    PRIMARY KEY(id_cxp),
    FOREIGN KEY(id_factura_compra)                          REFERENCES tab_encabezado_factura_compra(id_factura),
    FOREIGN KEY(id_proveedor)                               REFERENCES tab_proveedores(id_proveedor),
    FOREIGN KEY(id_estado)                                  REFERENCES tab_estados(id_estado)
);

