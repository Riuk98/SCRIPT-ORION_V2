CREATE TABLE IF NOT EXISTS tab_encabezado_comprobante
(
    id_comprobante              DECIMAL(4,0)                NOT NULL, --Consecutivo propio del comprobante RC o CE
    id_tipo_doc                 DECIMAL(2,0)                NOT NULL, --FK a tabla de tipos de documento (RC o CE)
    id_tercero                  DECIMAL(10,0)               NOT NULL, --FK a tabla de terceros (cliente o proveedor)
    fecha_recibo                TIMESTAMP WITHOUT TIME ZONE NOT NULL, --Fecha de emisión del recibo
    id_usuario_creacion         VARCHAR                     NOT NULL, --FK a tabla de usuarios (usuario que creó el comprobante)
    obs_recibo                  VARCHAR                     NOT NULL, --Observaciones sobre el recibo
    id_medio_pago               DECIMAL(1,0)                NOT NULL, --FK a tabla de medios de pago
    valor_total                 DECIMAL(10,2)               NOT NULL, --Valor total del comprobante
    tipo_pago                   decimal(1,0)                NOT NULL, --1 CREDITO, 2 CONTADO
    --fecha_modifica            TIMESTAMP WITHOUT TIME ZONE NOT NULL, // NO SE SI COLOCARLO
    --usuario_modifica          VARCHAR                     NOT NULL, // NO SE SI COLOCARLO
    PRIMARY KEY(id_comprobante),
    FOREIGN KEY(id_tipo_doc)                                REFERENCES tab_tipos_documento(id_tipo_doc),
    FOREIGN KEY(id_tercero)                                 REFERENCES tab_terceros(id_tercero),
    FOREIGN KEY(id_usuario_creacion)                        REFERENCES tab_usuarios(id_usuario),
    FOREIGN KEY(id_medio_pago)                              REFERENCES tab_medio_pago(id_medio_pago)
);

